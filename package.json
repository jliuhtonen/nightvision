{
  "name": "@jliuhtonen/nightvision",
  "version": "0.2.4",
  "description": "Implementation of Lenbrook Service Discovery Protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf ./dist ./dist-test && rm -f .tsbuildinfo",
    "build:test": "rm -rf ./dist-test && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test ./dist-test/test/*.test.js",
    "start": "node --require ts-node/register ./test/testClient.ts",
    "build": "tsc",
    "distribute": "npm run clean && npx tsc && npm publish --access=public"
  },
  "author": "Janne Liuhtonen",
  "license": "MIT",
  "keywords": [
    "lsdp",
    "udp",
    "service discovery"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.2"
  }
}
